{
  "$schema": "node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-05-29",
  "name": "website",
  "main": "vike:server-entry",
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
    },
  },
